# Supabase (EU-region enligt K23)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endast for migrationer, aldrig i klienten. Session pooler-strang.
DATABASE_URL=

# Publik bas-URL, anvands i magiska lankar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hemlighet for de schemalagda jobben. Vercel skickar den som Bearer-token.
CRON_SECRET=

# Utgaende e-post. Domanen ar verifierad i Resend, avsandaren maste ligga
# under den — annars studsar brevet pa DKIM.
RESEND_API_KEY=
EMAIL_FROM=Clicknet Nav <hej@clicknet.se>

# Inkio, CRM:et (0074). Ett tjänstekontos nyckel: `token <nyckel>:<hemlighet>`.
# BARA I PRODUCTION i Vercel — utan dem faller Nav tillbaka på den manuella
# adaptern, så att en preview aldrig skriver i Inkio. Lokalt: ~/.clicknet/crm.env.
INKIO_URL=https://crm.inkio.se
INKIO_API_KEY=
INKIO_API_SECRET=
# Valfri: tjänstens id i Inkio för paketen. Annars "Optimerad Kampanjsida".
INKIO_TJANST_PAKET=
